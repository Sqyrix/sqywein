<Window x:Class="Sqywein.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sqywein" Icon="Assets/app.ico" Width="1280" Height="820" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Base}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing" StateChanged="OnStateChanged">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                  GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Sekme şeridi, başlık çubuğunun içinde -->
    <DockPanel Grid.Row="0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                  WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Küçült"/>
        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Ekranı kapla"/>
        <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnCloseWindow" ToolTip="Kapat"/>
      </StackPanel>

      <!-- Sağda boşluk bırakılır, pencere oradan sürüklenir -->
      <StackPanel Orientation="Horizontal" Margin="10,6,48,0" VerticalAlignment="Stretch">
        <Image Source="Assets/logo.png" Width="20" Height="20" Margin="0,0,8,6" VerticalAlignment="Center"/>
        <ItemsControl x:Name="TabStrip" WindowChrome.IsHitTestVisibleInChrome="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Tab" Height="34" Margin="0,0,2,0" Padding="10,0,4,0"
                      Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CornerRadius="8,8,0,0" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="OnTabMouseDown" MouseUp="OnTabMouseUp" Tag="{Binding}">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Sekmeyi uyut" Click="OnSleepTabMenu"/>
                    <MenuItem Header="Diğer sekmeleri uyut" Click="OnSleepOthersMenu"/>
                    <MenuItem Header="Sekmeyi kapat" Click="OnCloseTabMenu"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                  <Button x:Name="CloseTab" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                          Width="24" Height="24" FontSize="9" Content="&#xE8BB;"
                          Click="OnCloseTabClick" Tag="{Binding}" Visibility="Hidden" ToolTip="Kapat"/>
                  <Grid Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Faint}"/>
                    <Image x:Name="Fav" Source="{Binding Icon}" Width="16" Height="16"/>
                  </Grid>
                  <TextBlock x:Name="TabTitle" Text="{Binding Title}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"/>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Tab" Property="Background" Value="{StaticResource Raised}"/>
                  <Setter TargetName="CloseTab" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                  <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                  <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}"/>
                  <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="Fav" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAsleep}" Value="True">
                  <Setter TargetName="Tab" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="Tab" Property="Background" Value="{StaticResource Raised}"/>
                  <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource Ink}"/>
                  <Setter TargetName="CloseTab" Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource IconButton}" Content="&#xE710;" Height="30" Width="30" Margin="4,0,0,4"
                Click="OnNewTab" ToolTip="Yeni sekme (Ctrl+T)" WindowChrome.IsHitTestVisibleInChrome="True"/>
      </StackPanel>
    </DockPanel>

    <!-- Araç çubuğu -->
    <Border Grid.Row="1" Background="{StaticResource Raised}" BorderBrush="{StaticResource Base}" BorderThickness="0,0,0,1">
      <DockPanel Margin="8,0" VerticalAlignment="Center">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="OnBack" ToolTip="Geri (Alt+Sol)"/>
          <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="OnForward" ToolTip="İleri (Alt+Sağ)"/>
          <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="OnReload" ToolTip="Yenile (F5)"/>
        </StackPanel>

        <!-- Canlı RAM göstergesi: tarayıcının ana fikri, bu yüzden hep görünür -->
        <Border DockPanel.Dock="Right" Margin="8,0,2,0" Padding="10,0" Height="28" CornerRadius="14"
                BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="RamText" Text="…" Foreground="{StaticResource Accent}"
                       FontWeight="SemiBold" FontSize="12"/>
          </StackPanel>
        </Border>

        <Border Height="32" CornerRadius="16" Margin="6,0,0,0" Background="{StaticResource Base}"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
          <DockPanel>
            <TextBlock x:Name="LockIcon" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" Text="&#xE721;"
                       FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="13,0,8,0"/>
            <Button x:Name="StarButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Width="28" Height="28" Margin="0,0,2,0" Content="&#xE734;" Click="OnToggleFavorite" ToolTip="Favori (Ctrl+D)"/>
            <TextBox x:Name="AddressBar" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Accent}"
                     SelectionBrush="{StaticResource Accent}" VerticalAlignment="Center"
                     KeyDown="OnAddressKeyDown" GotKeyboardFocus="OnAddressFocus"
                     PreviewMouseLeftButtonDown="OnAddressMouseDown"/>
          </DockPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- İçerik: web görünümleri ve motorsuz başlangıç sayfası -->
    <Grid Grid.Row="2" x:Name="ContentHost" Background="{StaticResource Base}">
      <Grid x:Name="StartPage">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" Margin="24,-60,24,0">
          <!-- Sekmeler uyurken kedi de uyur -->
          <Grid Height="176" Margin="0,0,0,10">
            <Image x:Name="AwakeMascot" HorizontalAlignment="Center">
              <Image.Source><BitmapImage UriSource="Assets/mascot.png" DecodePixelHeight="352"/></Image.Source>
            </Image>
            <Grid x:Name="SleepingMascot" Width="186" Height="116" VerticalAlignment="Bottom"
                  HorizontalAlignment="Center" Visibility="Collapsed">
              <Image VerticalAlignment="Bottom">
                <Image.Source><BitmapImage UriSource="Assets/mascot-sleeping.png" DecodePixelHeight="232"/></Image.Source>
              </Image>
              <Canvas>
                <TextBlock Text="z" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Accent}" Canvas.Left="118" Canvas.Top="-6"/>
                <TextBlock Text="z" FontWeight="Bold" FontSize="21" Foreground="{StaticResource Accent}" Canvas.Left="134" Canvas.Top="-24"/>
                <TextBlock Text="z" FontWeight="Bold" FontSize="28" Foreground="{StaticResource Accent}" Canvas.Left="154" Canvas.Top="-50"/>
              </Canvas>
            </Grid>
          </Grid>
          <TextBlock Text="Sqywein" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="36"
                     Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
          <TextBlock x:Name="StartRam" Foreground="{StaticResource Faint}" FontSize="12.5"
                     HorizontalAlignment="Center" Margin="0,2,0,24"/>
          <Border Height="46" CornerRadius="23" Background="{StaticResource Raised}"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,30">
            <Grid Margin="20,0">
              <TextBlock x:Name="StartHint" Text="Ara ya da adres yaz" Foreground="{StaticResource Faint}"
                         FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0,0,0"/>
              <TextBox x:Name="StartSearch" Background="Transparent" BorderThickness="0" FontSize="14"
                       Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Accent}"
                       SelectionBrush="{StaticResource Accent}" VerticalAlignment="Center"
                       KeyDown="OnStartKeyDown" TextChanged="OnStartTextChanged"/>
            </Grid>
          </Border>
          <ItemsControl x:Name="FavoritesList" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Tile" Width="92" Padding="0,10" Margin="4" CornerRadius="10"
                        Background="Transparent" Cursor="Hand" Tag="{Binding}"
                        MouseLeftButtonUp="OnFavoriteClick" ToolTip="{Binding Url}">
                  <StackPanel>
                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource Raised}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                      <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" FontSize="16"
                                 Foreground="{StaticResource Accent}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" Margin="4,8,4,0"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource Raised}"/>
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
